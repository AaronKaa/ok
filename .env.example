# Server Configuration
PORT=8080
REFRESH_INTERVAL=10s

# Health Checks
# Define checks using CHECKS (JSON array) or CHECKS_<name> (single object or array)

# Main checks array
CHECKS='[{"title":"API","url":"http://api:8080/health","interval":"30s","critical":true}]'

# Additional checks can be defined with CHECKS_<name> prefix
# Single check object:
CHECKS_DB='{"title":"Database","url":"http://db:5432/health","interval":"60s","critical":true}'

# Array of checks:
CHECKS_CACHE='[{"title":"Redis","url":"http://redis:6379/health","interval":"15s","critical":false}]'

# Check Configuration Options:
# - title:         Display name (required)
# - url:           Health endpoint URL (required)
# - method:        HTTP method (default: GET)
# - interval:      Check interval as duration string (default: 30s)
# - expect_status: Expected HTTP status code (default: 200)
# - json_path:     JSON path to extract value (optional, uses gjson syntax)
# - json_equals:   Expected value at json_path (optional)
# - critical:      If true, failure causes aggregate fail (default: true)
# - retries:       Failures before marking as failed (default: 0)

# Example with JSON path validation:
# CHECKS_CUSTOM='{"title":"Service","url":"http://service/status","json_path":"status","json_equals":"healthy"}'
